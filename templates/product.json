{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "badge": {
          "type": "text",
          "settings": {
            "text": "⭐ 4,9/5 · Plus de 10 000 avis vérifiés",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "inventory_threshold": 10,
            "show_inventory_quantity": false,
            "text_style": "body"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "benefits_icons": {
          "type": "icon-with-text",
          "settings": {
            "icon_1": "check-mark",
            "heading_1": "Sans médicaments",
            "icon_2": "truck",
            "heading_2": "Livraison rapide",
            "icon_3": "return",
            "heading_3": "30 jours pour retourner"
          }
        },
        "description": {
          "type": "description"
        },
        "faq_accordion": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Comment utiliser l'étireur ?",
            "icon": "none",
            "content": "<p>Allongez-vous sur le dos. Placez l'étireur sous vos lombaires. Relaxez pendant 10 à 15 minutes. Répétez chaque jour pour des résultats optimaux.</p>",
            "page": ""
          }
        },
        "faq_accordion_2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Pour qui est-il recommandé ?",
            "icon": "none",
            "content": "<p>Idéal pour les personnes souffrant de lombalgies chroniques, hernie discale (L4-L5, L5-S1), sciatique, tensions musculaires ou douleurs dues à la position assise prolongée.</p>",
            "page": ""
          }
        },
        "faq_accordion_3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Y a-t-il des contre-indications ?",
            "icon": "none",
            "content": "<p>Déconseillé après une chirurgie vertébrale récente, en cas de grossesse ou d'ostéoporose sévère. Consultez votre médecin en cas de doute.</p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Partager"
          }
        }
      },
      "block_order": [
        "badge",
        "title",
        "price",
        "inventory",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "benefits_icons",
        "description",
        "faq_accordion",
        "faq_accordion_2",
        "faq_accordion_3",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": false,
        "enable_video_looping": true,
        "padding_top": 40,
        "padding_bottom": 20
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Vous pourriez aussi aimer",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
