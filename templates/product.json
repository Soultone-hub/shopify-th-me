{
  "sections": {
    "main": {
      "type": "product-information",
      "blocks": {
        "disclosures_faq": {
          "type": "disclosures",
          "settings": {
            "divider_color": "{{ settings.color_palette.color2 }}"
          }
        },
        "static-media-gallery": {
          "type": "_product-media-gallery",
          "settings": {
            "layout": "grid",
            "columns": 2,
            "enable_zoom": true
          }
        },
        "static-product-details": {
          "type": "_product-details",
          "settings": {
            "enable_sticky": true
          },
          "blocks": {
            "title_group": {
              "type": "group",
              "settings": {},
              "blocks": {
                "product_title": {
                  "type": "product-title",
                  "settings": {
                    "content": "<h1>{{ closest.product.title }}</h1>"
                  }
                },
                "product_price": {
                  "type": "price",
                  "settings": {}
                }
              },
              "block_order": ["product_title", "product_price"]
            },
            "divider_1": {
              "type": "_divider",
              "settings": {}
            },
            "variant_picker": {
              "type": "variant-picker",
              "settings": {
                "style": "buttons"
              }
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "settings": {},
              "blocks": {
                "quantity_input": {
                  "type": "quantity",
                  "settings": {}
                },
                "add_to_cart": {
                  "type": "add-to-cart",
                  "settings": {
                    "label": "Ajouter au panier"
                  }
                },
                "accelerated_checkout": {
                  "type": "accelerated-checkout",
                  "settings": {}
                }
              },
              "block_order": ["quantity_input", "add_to_cart", "accelerated_checkout"]
            },
            "product_description": {
              "type": "text",
              "settings": {
                "content": "{{ closest.product.description }}"
              }
            },
            "accordion_shipping": {
              "type": "accordion",
              "settings": {
                "title": "Livraison & Retours",
                "content": "<p>🚚 Livraison gratuite en France métropolitaine sous 3-5 jours ouvrés.<br>↩️ Retours gratuits sous 30 jours — satisfait ou remboursé.</p>"
              }
            },
            "accordion_usage": {
              "type": "accordion",
              "settings": {
                "title": "Comment l'utiliser ?",
                "content": "<p>1. Placez l'étireur sur une surface plane<br>2. Allongez-vous en centrant votre zone lombaire<br>3. Commencez au niveau le plus bas<br>4. Restez 5 à 10 minutes par jour<br>5. Augmentez progressivement le niveau</p>"
              }
            },
            "accordion_guarantee": {
              "type": "accordion",
              "settings": {
                "title": "Notre garantie",
                "content": "<p>✅ Garantie satisfait ou remboursé 30 jours<br>🛡️ Garantie fabricant 1 an<br>📞 Support client réactif 7j/7</p>"
              }
            }
          },
          "block_order": ["title_group", "divider_1", "variant_picker", "buy_buttons", "product_description", "accordion_shipping", "accordion_usage", "accordion_guarantee"]
        }
      },
      "block_order": ["disclosures_faq", "static-media-gallery", "static-product-details"],
      "settings": {
        "enable_sticky_add_to_cart": true
      }
    },
    "product_recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "Vous aimerez aussi",
        "products_to_show": 4,
        "columns_large": 4,
        "columns_small": 2,
        "layout": "grid"
      }
    }
  },
  "order": ["main", "product_recommendations"]
}