{
  "sections": {
    "main": {
      "type": "product-information",
      "blocks": {
        "media_gallery": {
          "type": "_product-media-gallery",
          "settings": {
            "layout": "grid",
            "columns": 2,
            "enable_zoom": true
          }
        },
        "product_details": {
          "type": "_product-details",
          "settings": {
            "enable_sticky": true
          },
          "blocks": {
            "breadcrumb": {
              "type": "_inline-text",
              "settings": { "text": "Correcteur lombaire" }
            },
            "title": {
              "type": "product-title",
              "settings": {}
            },
            "rating": {
              "type": "review",
              "settings": {}
            },
            "price": {
              "type": "price",
              "settings": {}
            },
            "divider_1": {
              "type": "_divider",
              "settings": {}
            },
            "variants": {
              "type": "variant-picker",
              "settings": { "style": "buttons" }
            },
            "buy_group": {
              "type": "buy-buttons",
              "settings": {},
              "blocks": {
                "qty": { "type": "quantity", "settings": {} },
                "atc": {
                  "type": "add-to-cart",
                  "settings": { "label": "Ajouter au panier" }
                },
                "checkout": {
                  "type": "accelerated-checkout",
                  "settings": {}
                }
              },
              "block_order": ["qty", "atc", "checkout"]
            },
            "trust_icons": {
              "type": "text",
              "settings": {
                "content": "<p style='font-size:13px;color:#0B3D37;'>✅ Livraison gratuite &nbsp; | &nbsp; ↩️ Retours 30j &nbsp; | &nbsp; 🛡️ Garantie 1 an</p>"
              }
            },
            "divider_2": {
              "type": "_divider",
              "settings": {}
            },
            "description": {
              "type": "product-description",
              "settings": {}
            },
            "accordion_usage": {
              "type": "accordion",
              "settings": {
                "title": "Comment l'utiliser",
                "content": "<p><strong>Étape 1 :</strong> Positionnez le correcteur dans votre dos.<br><strong>Étape 2 :</strong> Ajustez les sangles pour un maintien confortable.<br><strong>Étape 3 :</strong> Portez 2 à 4h par jour pour des résultats durables.<br><br>Résultats visibles en 2 à 3 semaines d'utilisation régulière.</p>"
              }
            },
            "accordion_shipping": {
              "type": "accordion",
              "settings": {
                "title": "Livraison & Retours",
                "content": "<p>🚚 Livraison offerte en France métropolitaine (3-5 jours)<br>📦 Livraison express disponible (24h)<br>↩️ Retours gratuits sous 30 jours — satisfait ou remboursé</p>"
              }
            },
            "accordion_faq": {
              "type": "accordion",
              "settings": {
                "title": "Questions fréquentes",
                "content": "<p><strong>Convient-il à toutes les morphologies ?</strong><br>Oui, disponible du S au XXL avec des sangles réglables.<br><br><strong>Puis-je le porter au bureau ?</strong><br>Absolument. Discret sous les vêtements, il est idéal pour le travail.<br><br><strong>Est-il remboursé par la Sécurité Sociale ?</strong><br>Non, mais son prix reste accessible. Contactez votre mutuelle pour vérifier votre couverture.</p>"
              }
            }
          },
          "block_order": ["breadcrumb", "title", "rating", "price", "divider_1", "variants", "buy_group", "trust_icons", "divider_2", "description", "accordion_usage", "accordion_shipping", "accordion_faq"]
        }
      },
      "block_order": ["media_gallery", "product_details"],
      "settings": {
        "enable_sticky_add_to_cart": true
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "Vous aimerez aussi",
        "products_to_show": 4,
        "columns_large": 4,
        "columns_small": 2,
        "layout": "grid"
      }
    }
  },
  "order": ["main", "recommendations"]
}