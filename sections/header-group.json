{
  "type": "header",
  "name": "Header group",
  "sections": {
    "announcement_bar": {
      "type": "header-announcements",
      "blocks": {
        "announcement_1": {
          "type": "_announcement",
          "settings": {
            "text": "Livraison gratuite en France 🇫🇷 | Satisfait ou remboursé 30 jours"
          }
        }
      },
      "block_order": ["announcement_1"],
      "settings": {
        "background_color": "#1A9E85",
        "text_color": "#FFFFFF",
        "divider_color": "{{ settings.color_palette.color2 }}"
      }
    },
    "header_section": {
      "type": "header",
      "blocks": {
        "header_logo": {
          "type": "_header-logo",
          "settings": {}
        },
        "header_menu": {
          "type": "_header-menu",
          "settings": {
            "menu": "main-menu",
            "style": "featured_products"
          }
        }
      },
      "block_order": ["header_logo", "header_menu"],
      "settings": {
        "logo_position": "left",
        "menu_position": "left",
        "sticky_header": "always",
        "show_search": true,
        "show_country_selector": false,
        "show_language_selector": false
      }
    }
  },
  "order": ["announcement_bar", "header_section"]
}
