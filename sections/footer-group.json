{
  "type": "footer",
  "name": "Footer group",
  "sections": {
    "footer_main": {
      "type": "footer",
      "blocks": {
        "newsletter_group": {
          "type": "group",
          "settings": {
            "title": "Rejoignez notre communauté bien-être"
          },
          "blocks": {
            "newsletter_text": {
              "type": "text",
              "settings": {
                "content": "<p>Recevez nos conseils santé et offres exclusives directement dans votre boîte mail.</p>"
              }
            },
            "newsletter_signup": {
              "type": "email-signup",
              "settings": {
                "border_radius": 100
              }
            }
          },
          "block_order": ["newsletter_text", "newsletter_signup"]
        },
        "footer_menu": {
          "type": "menu",
          "settings": {
            "menu": "footer",
            "heading": "Aide"
          }
        },
        "footer_legal_menu": {
          "type": "menu",
          "settings": {
            "menu": "footer-legal",
            "heading": "Informations légales"
          }
        }
      },
      "block_order": ["newsletter_group", "footer_menu", "footer_legal_menu"],
      "settings": {}
    },
    "footer_utilities": {
      "type": "footer-utilities",
      "blocks": {
        "copyright": {
          "type": "footer-copyright",
          "settings": {
            "show_powered_by": false
          }
        },
        "policy_list": {
          "type": "footer-policy-list",
          "settings": {}
        }
      },
      "block_order": ["copyright", "policy_list"],
      "settings": {}
    }
  },
  "order": ["footer_main", "footer_utilities"]
}
